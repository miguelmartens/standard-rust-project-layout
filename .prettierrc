# Formatting for the files rustfmt does not touch.
#
# Division of labour in this repository:
#
#   *.rs             rustfmt      rustfmt.toml, enforced by `cargo fmt --check`
#   *.md *.yaml      Prettier     this file
#   *.json           Prettier     this file
#   *.toml           nobody       Prettier has no TOML parser; use taplo if you
#                                 want one. Cargo does not care either way.
#
# Prettier is OPTIONAL for contributors. `cargo xtask fmt` and `cargo xtask ci`
# run it when npx is on PATH and print a skip notice when it is not, so `rustup`
# stays the only hard requirement for working on this repository. CI always has
# Node, so CI always runs it -- a config that nothing enforces drifts.
#
# ---------------------------------------------------------------------------
# WHY THIS FILE IS YAML AND NOT JSON
#
# Prettier reads `.prettierrc` as JSON *or* YAML, and the failure mode of
# guessing wrong is nasty: JSON-with-comments does not error, it parses as YAML,
# turns the comment into a key, silently ignores every option after it, and
# exits 0. Verified with Prettier 3.9.6:
#
#     {                              ->  Ignored unknown option
#       // printWidth is 40                { "// printWidth is 40": 40 }
#       "printWidth": 40             ->  and printWidth was never applied
#     }
#
# YAML has real comments, so this file can explain itself the way every other
# config file here does. If you prefer JSON, drop the comments entirely --
# do not keep them.
# ---------------------------------------------------------------------------

# Four options. Two are real overrides, two are deliberate restatements, and the
# comments say which -- because "why is this line here" is the question a config
# file should never leave a reader asking.

# OVERRIDE. Prettier's default is 80. 100 matches rustfmt's default max_width
# (set by the Rust Style Guide, which is why rustfmt.toml does not restate it),
# so a code block that fits inside a .rs file also fits inside the Markdown that
# quotes it.
printWidth: 100

# OVERRIDE, and a non-obvious one. Prettier 3 reads .editorconfig by default,
# and .editorconfig sets indent_size = 4 for [*], which covers Markdown. Without
# this line, nested Markdown lists would indent by four. Verified: removing it
# changes the output.
tabWidth: 2

# RESTATES THE DEFAULT, deliberately. `always` rewraps a whole paragraph when one
# word changes, and the reviewer can no longer see which sentence moved. That is
# a trap worth blocking in writing rather than leaving to whoever edits this file
# next.
proseWrap: preserve

# RESTATES THE DEFAULT, as a cross-check. .gitattributes enforces LF in git and
# .editorconfig declares it for editors; this file takes precedence over the
# latter, so it had better agree with both. Three files, one answer.
endOfLine: lf
